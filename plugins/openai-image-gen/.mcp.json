{
  "mcpServers": {
    "openai-image-gen": {
      "command": "uv",
      "args": ["run", "--script", "${CLAUDE_PLUGIN_ROOT}/server.py"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_BASE_URL": "${OPENAI_BASE_URL:-}",
        "IMAGE_MODEL": "${IMAGE_MODEL:-gpt-image-2.5-flare}",
        "IMAGE_OUTPUT_DIR": "${IMAGE_OUTPUT_DIR:-generated-images}",
        "IMAGE_DEFAULT_SIZE": "${IMAGE_DEFAULT_SIZE:-auto}",
        "IMAGE_DEFAULT_QUALITY": "${IMAGE_DEFAULT_QUALITY:-auto}",
        "IMAGE_PREVIEW_MAX_PX": "${IMAGE_PREVIEW_MAX_PX:-512}"
      }
    }
  }
}
