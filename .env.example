# Copy to .env and fill in:  cp .env.example .env

# --- required ---
OPENAI_API_KEY=sk-...
# Long random string, part of every URL. Generate with:  openssl rand -hex 24
MCP_SECRET=

# Your public address, no trailing slash (used for download links)
PUBLIC_BASE_URL=https://img.example.com
# Only needed with the built-in Caddy HTTPS (same host as PUBLIC_BASE_URL, without https://)
DOMAIN=img.example.com

# --- optional ---
# OPENAI_BASE_URL=https://your-relay.example.com/v1
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_DEFAULT_SIZE=auto
IMAGE_DEFAULT_QUALITY=auto
# Preview size returned to Claude (longest side, px). Bigger = clearer but uses more context. Max 2048.
IMAGE_PREVIEW_MAX_PX=512

# Storage protection: 1 GiB images, keep 2 GiB disk free. No automatic deletion.
IMAGE_STORAGE_MAX_BYTES=1073741824
IMAGE_MIN_FREE_BYTES=2147483648

# Optional web manager at /admin. Use a separate random password (16+ characters).
# IMAGE_ADMIN_PASSWORD=

# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs).
# Default covers Caddy on the compose network and Nginx on the host via Docker's bridge.
# TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
